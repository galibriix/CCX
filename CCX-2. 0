@bot.tree.command(
    name="sm",
    description="Assign the Suspicious Member role."
)
@moderator_only()
async def suspicious_member(
    interaction: discord.Interaction,
    member: discord.Member,
    reason: str
):

    if not SM_ROLE_ID:
        await interaction.response.send_message(
            "SM_ROLE_ID has not been configured.",
            ephemeral=True
        )
        return

    role = interaction.guild.get_role(SM_ROLE_ID)

    if not role:
        await interaction.response.send_message(
            "SM role not found.",
            ephemeral=True
        )
        return

    if role >= interaction.guild.me.top_role:
        await interaction.response.send_message(
            "The bot's role must be above the SM role.",
            ephemeral=True
        )
        return

    await member.add_roles(
        role,
        reason=reason
    )

    await send_dm(
        member,
        "⚠️ **CCX SECURITY NOTICE**\n\n"
        "Your account has been assigned the "
        "**Suspicious Member (SM)** role.\n\n"
        f"Reason: {reason}\n\n"
        "Some community features may be restricted. "
        "Please contact Galibriix, CCX moderator, "
        "for assistance."
    )

    await interaction.response.send_message(
        f"SM role assigned to {member.mention}.",
        ephemeral=True
    )


