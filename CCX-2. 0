# ==========================================
# TIMEOUT COMMAND
# ==========================================

@bot.tree.command(
    name="timeout",
    description="Timeout a member."
)
@moderator_only()
async def timeout(
    interaction: discord.Interaction,
    member: discord.Member,
    minutes: app_commands.Range[int, 1, 40320],
    reason: str
):

    await interaction.response.defer(ephemeral=True)

    if member.id == interaction.user.id:
        await interaction.followup.send(
            "You cannot timeout yourself."
        )
        return

    if member.top_role >= interaction.user.top_role:
        await interaction.followup.send(
            "You cannot moderate this member because "
            "their role is equal to or higher than yours."
        )
        return

    await member.timeout(
        timedelta(minutes=minutes),
        reason=reason
    )

    await send_dm(
        member,
        "⏳ **CCX TIMEOUT NOTICE**\n\n"
        "You have been timed out in CCX.\n"
        f"Reason: {reason}\n"
        f"Duration: {minutes} minutes\n"
        f"Moderator: {interaction.user}"
    )

    await interaction.followup.send(
        f"⏳ {member.mention} timed out for {minutes} minutes."
    )


