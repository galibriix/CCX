@bot.event
async def on_member_join(member):

    db.execute(
        """
        INSERT OR REPLACE INTO members
        (user_id, username, joined_at)
        VALUES (?, ?, ?)
        """,
        (
            member.id,
            str(member),
            discord.utils.utcnow().isoformat()
        )
    )
    db.commit()

    welcome = (
        f"🚀 Welcome to **CCX**, {member.name}!\n\n"
        "WE CODE. WE CREATE. WE BUILD. WE RISE.\n\n"
        "Explore our coding community, participate in "
        "challenges, showcase projects and connect with "
        "other developers.\n\n"
        "Enjoy your stay!"
    )

    await send_dm(member, welcome)

    if WELCOME_CHANNEL_ID:
        channel = bot.get_channel(WELCOME_CHANNEL_ID)

        if channel:
            await channel.send(
                f"🎉 Welcome {member.mention} to **CCX!**"
            )


