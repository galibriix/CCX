async def ask_ai(question: str):

    url = "https://openrouter.ai/api/v1/chat/completions"

    headers = {
        "Authorization": f"Bearer {AI_KEY}",
        "Content-Type": "application/json",
        "X-Title": "CCX 2.0"
    }

    payload = {
        "model": AI_MODEL,
        "messages": [
            {
                "role": "system",
                "content": (
                    "You are CCX AI, the intelligent assistant "
                    "of Code Creators X. You are helpful, "
                    "technically knowledgeable and excellent "
                    "at programming, science and mathematics. "
                    "Give accurate, clear and useful responses. "
                    "Never pretend to execute code you have "
                    "not actually executed."
                )
            },
            {
                "role": "user",
                "content": question
            }
        ],
        "temperature": 0.5,
        "max_tokens": 1500
    }

    timeout = aiohttp.ClientTimeout(total=45)

    async with aiohttp.ClientSession(
        timeout=timeout
    ) as session:

        async with session.post(
            url,
            headers=headers,
            json=payload
        ) as response:

            if response.status != 200:
                error = await response.text()
                raise RuntimeError(
                    f"AI provider error: {response.status}"
                )

            data = await response.json()

            return data["choices"][0]["message"]["content"]


